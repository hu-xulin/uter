{
  "$schema": "./node_modules/knip/schema.json",
  // Each pattern below carries an explicit justification; do not add blanket
  // ignores without one. MA-09 (UAES manual acceptance) runs `knip` as a
  // dead-code signal check — keep it strict for application code.
  // Supersedes the former knip.config.ts (merged 2026-11-06, file removed).
  "entry": [
    // SPA + TanStack Router entry chain: index.html -> src/main.tsx -> routeTree.gen.ts -> src/routes/**
    "index.html",
    "src/main.tsx",
    // E2E suites are executables (playwright globalSetup includes e2e/visual/lib/service-gate.ts)
    "e2e/**/*.{ts,tsx}",
    // Repo maintenance scripts executed manually per docs (e.g.
    // docs/design-system/UTER-DESIGN-SYSTEM-3.0.md documents
    // `node scripts/generate-design-showcase.mjs`)
    "scripts/**/*.{ts,mts,cts,mjs,cjs}",
    // Vendored assistant-ui component library: full API surface is intentionally
    // kept in sync with upstream; pruning exports would break upstream diffs
    "src/components/ai-elements/**/*.{ts,tsx}",
    // Design-system component library tracked by the component registry
    // (scripts/check-component-registry.mjs enforces the declared set)
    "src/components/ui/**/*.{ts,tsx}",
    // Complete brand-icon library per the design contract: icons are rendered
    // by key from the full set; unused entries stay for future channels
    "src/assets/brand-icons/**/*.{ts,tsx}",
  ],
  "ignore": [
    // Vendor protocol-capability plugin bundles served from /plugins/** and
    // loaded by URL at runtime; first line of every file declares
    // "Protocol capabilities, not prices." — never statically imported
    "public/plugins/**",
    // Deliberately parked component; see src/routes/__root.tsx comment
    // ("components/navigation-progress 与 react-top-loading-bar 依赖原样保留")
    "src/components/navigation-progress.tsx",
    // Data file consumed via fs.readFileSync by scripts/check-i18n-keys.mjs
    // (npm run i18n:check); it is never imported
    "src/i18n/static-keys.ts",
    // Design-contract declaration file: the single allowed home for third-party
    // brand colors (design-system spec §T8 / UTER-UAES P05). Its constants are
    // declarative API surface — including OAUTH_BRAND_COLORS — and must not be
    // pruned by dead-code analysis
    "src/design-system/tokens/brand-colors.ts",
  ],
  "ignoreDependencies": [
    // Only imported by the parked navigation-progress component (see ignore above)
    "react-top-loading-bar",
    // CLI tooling: axe probe (MA-12 / M05-02), invoked ad hoc
    "@axe-core/cli",
    // scripts/axe-audit.mjs imports playwright directly (bundled with
    // @playwright/test); it is an ad-hoc evidence tool, not app code.
    "playwright",
  ],
  // Exports referenced within their own file (e.g. exported for tests or for
  // local readability) are not dead API surface
  "ignoreExportsUsedInFile": true,
}
