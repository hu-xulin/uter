{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uap://schemas/task",
  "title": "UAP Task",
  "type": "object",
  "required": [
    "task_id",
    "objective",
    "scope",
    "specification_ids",
    "constraints",
    "acceptance_criteria",
    "state",
    "steps",
    "trace_id"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^UAP-TASK-"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string"
    },
    "specification_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^UAP-\\d\\d-\\d\\d\\d$"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agent_id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "CREATED",
        "QUEUED",
        "RUNNING",
        "PAUSED",
        "WAITING_RECOVERY",
        "BLOCKED",
        "FAILED",
        "SUCCEEDED",
        "CANCELLED"
      ]
    },
    "trace_id": {
      "type": "string"
    },
    "context_version": {
      "type": "string"
    },
    "max_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_results": {
      "type": "array",
      "items": {
        "$ref": "validator-result.schema.json"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "at"
        ],
        "properties": {
          "from": {
            "enum": [
              "CREATED",
              "QUEUED",
              "RUNNING",
              "PAUSED",
              "WAITING_RECOVERY",
              "BLOCKED",
              "FAILED",
              "SUCCEEDED",
              "CANCELLED"
            ]
          },
          "to": {
            "enum": [
              "CREATED",
              "QUEUED",
              "RUNNING",
              "PAUSED",
              "WAITING_RECOVERY",
              "BLOCKED",
              "FAILED",
              "SUCCEEDED",
              "CANCELLED"
            ]
          },
          "at": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": [
        "step_id",
        "name",
        "status",
        "attempts",
        "evidence_refs"
      ],
      "properties": {
        "step_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "handler": {
          "type": "string"
        },
        "idempotent": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PENDING",
            "SUCCEEDED",
            "FAILED",
            "BLOCKED"
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputs": {
          "type": "object"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
