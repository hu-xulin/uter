# UEQE 策略配置（Uter Engineering Quality Engine）
# 由 scripts/quality/uter-quality.sh 以 source 方式读取，纯 shell 兼容语法。
# 修改阈值须与 CI（.github/workflows/ci.yml）保持同口径，只紧不松。

# ── Go 覆盖率门禁阈值（与 ci.yml:205-208 一致，按包逐个设线，防稀释）──
UEQE_COVERAGE_ARGS="controller=39 model=45 service=43"

# ── 四个独立 Go 模块清单（go.mod 所在目录，逐个执行 vet/build/test）──
UEQE_GO_MODULES=". tokenkit relaykit tokenkit/tokenkit"

# ── Go 单模块测试超时（秒），防止个别包 hang 死拖垮整轮 ──
UEQE_GO_TEST_TIMEOUT=600

# ── 前端门禁清单（在 web/ 下按序执行；顺序=先便宜后昂贵）──
UEQE_WEB_GATES="lint typecheck test lint:design:strict copyright:check"

# ── 回归轨：第一轨（showcase 零依赖）恒跑；第二轨 Playwright 仅 --with-e2e ──
UEQE_VISUAL_FAST="test:visual"
UEQE_VISUAL_E2E="test:visual:e2e"

# ── 安全扫描工具；缺失时报 NOT_RUN 而不是伪通过 ──
UEQE_SEC_TOOLS="govulncheck gitleaks"

# ── 敏感文件不得入库清单（git ls-files 抽查）──
UEQE_FORBIDDEN_PATTERNS=".env *.db *.sqlite3"

# ── 报告落点（gitignore 区，不进主分支）──
UEQE_REPORT_ROOT="_reports/quality"
UEQE_STATE_DIR=".quality/.state"
